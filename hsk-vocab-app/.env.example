# ── Super Admin Emails (comma-separated, server-side) ──
SUPER_ADMIN_EMAILS=

# ── Supabase Service Role Key (SERVER-SIDE ONLY) ──
SUPABASE_SERVICE_ROLE_KEY=

# ── Captcha Secret (server-side) ──
CAPTCHA_SECRET=

# ── Visitor Salt (server-side) ──
VISITOR_SALT=
