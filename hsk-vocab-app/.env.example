# ── Supabase ──
# Get these from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://wcdlyznqnjeoghsigbpt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── AI Backend ──
NEXT_PUBLIC_AI_BACKEND_URL=

# ── App Mode ──
NEXT_PUBLIC_APP_MODE=development

# ── DeepSeek API Key (SERVER-SIDE ONLY) ──
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ── CORS Allowed Origins (comma-separated, server-side) ──
ALLOWED_ORIGINS=http://localhost:3000,https://hsk.ncwu.site

# ── Upstash Redis (OPTIONAL, server-side) ──
UPSTASH_REDIS_REST_URL=
